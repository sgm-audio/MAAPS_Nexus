[flake8]
max-line-length = 100
extend-ignore = E203,W293,E731
per-file-ignores =
    tests/*.py:E402,F401,F841,F541,E501
    tests/utils/*.py:E402,F401,F841
    tests/performance/*.py:E402,F401,F841,F541,E722
    tests/conftest.py:E402,F401
    api/routers/*.py:F401,F541
    api/schemas/*.py:F401
    api/main.py:F401,F824,F841
    api/message_bus_adapter.py:F401
    api/websocket.py:F401,E501
    api/auth.py:F401
    api/user_db.py:F401
    src/agents/*.py:F401,F841,E501
    src/agents/live/*.py:F401,F841,E722,F541,E402,E501
    src/agents/live/AudioAgent/*.py:F401,F841,E722,F541,E402,E501,W293
    src/agents/live/AudioAgent/core/*.py:F401,F841,E722,F541,E501,W293,E741
    src/agents/live/AudioAgent/main.py:F401,F841,E722,F541,E402,E501
    src/agents/live/cv-director/src/cv_director/*.py:F401,E722,E501
    src/agents/transcription/*.py:F401,F841,E722
    src/core/*.py:F401,F841
    src/infrastructure/*.py:F401,F841,F541
    src/daw_integration/*.py:F401,F841
    src/orchestration/*.py:F401,F841,E501
    src/utils/*.py:F401,F841
    src/nexus_system.py:F401,F841
    src/system.py:F401,F841,E501
