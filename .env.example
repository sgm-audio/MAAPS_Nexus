# MAAPS Nexus — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM Integration (choose one or none) ────────────────────────────────────

# Google Cloud Vertex AI (recommended for production)
# VERTEX_PROJECT_ID=your-gcp-project-id
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=claude-3-5-sonnet@20241022

# Anthropic API (direct)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Ollama (local, no key required)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── System Tuning ────────────────────────────────────────────────────────────

# Log level: DEBUG | INFO | WARNING | ERROR
AGENT_LOG_LEVEL=INFO

# Message bus queue depth
MESSAGE_BUS_MAX_QUEUE_SIZE=10000

# ── Resource Limits ──────────────────────────────────────────────────────────

MAX_CPU_USAGE=85.0
MAX_MEMORY_USAGE=90.0
CACHE_MAX_SIZE_MB=500

# ── API Server (legacy system) ───────────────────────────────────────────────

# JWT signing secret — REQUIRED; placeholders (e.g. change-me-before-deploying) refuse startup
SECRET_KEY=change-me-before-deploying
# API_SECRET_KEY is accepted as an alias if SECRET_KEY is unset/placeholder

# Seed admin/admin123 and demo/demo123 only when true (never in production)
# DEBUG=true

# Production bootstrap (when DEBUG is off): set both to create one admin at startup
# BOOTSTRAP_ADMIN_USER=admin
# BOOTSTRAP_ADMIN_PASSWORD=

# Comma-separated browser origins. If unset or *, CORS is * with credentials=false
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Token expiry in minutes
# ACCESS_TOKEN_EXPIRE_MINUTES=60
