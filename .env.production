# Multi-Agent Audio Processing System - PRODUCTION Configuration
# Copy this to .env for production deployment

# System Configuration
AGENT_LOG_LEVEL=WARNING
AGENT_HEARTBEAT_INTERVAL=5.0

# Message Bus - Optimized for production
MESSAGE_BUS_MAX_QUEUE_SIZE=50000
MESSAGE_BUS_DISPATCHER_THREADS=8

# Resource Limits - Production settings
MAX_CPU_USAGE_PERCENT=80.0
MAX_MEMORY_USAGE_PERCENT=85.0
MAX_GPU_USAGE_PERCENT=90.0

# Cache Configuration - Production optimized
CACHE_MAX_SIZE_MB=2000
CACHE_EVICTION_POLICY=lru

# Database - Production paths
METADATA_DB_PATH=./data/metadata.db
PROJECT_DB_PATH=./data/projects.db

# Performance - Production tuning
ENABLE_GPU=false
GPU_DEVICE_ID=0
MAX_WORKER_THREADS=16

# Monitoring - Production monitoring
ENABLE_HEALTH_MONITORING=true
HEALTH_CHECK_INTERVAL=10.0
METRICS_COLLECTION_INTERVAL=5.0

# Logging - Production logging
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/production.log
LOG_MAX_SIZE_MB=500
LOG_BACKUP_COUNT=10

# Audio Processing - Production defaults
DEFAULT_SAMPLE_RATE=44100
DEFAULT_BUFFER_SIZE=1024
AUDIO_CHUNK_SIZE=2048

# Workflow Configuration - Production settings
WORKFLOW_MAX_RETRIES=5
WORKFLOW_RETRY_DELAY_SECONDS=2.0
WORKFLOW_DEFAULT_TIMEOUT_SECONDS=600

# Safety Limits - Production restrictions
MAX_AUDIO_LENGTH_SECONDS=1800
MAX_PROCESSING_TIME_SECONDS=600
MAX_CONCURRENT_WORKFLOWS=50

# Security - Production security
ENABLE_REQUEST_VALIDATION=true
MAX_REQUEST_SIZE_MB=100
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# High Availability
AUTO_RESTART_FAILED_AGENTS=true
HEALTH_CHECK_TIMEOUT_SECONDS=30
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=60
