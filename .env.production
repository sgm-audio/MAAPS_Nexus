# MAAPS Production Environment Configuration
# Copy this file to .env.production and update with your actual values

# Application
ENVIRONMENT=production
LOG_LEVEL=info
WORKERS=4

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=maaps
DB_USER=maaps
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Security & Authentication
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET_KEY_HERE
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated origins)
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Database Paths (production should use absolute paths)
METADATA_DB_PATH=/app/data/metadata.db

# Monitoring
GRAFANA_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Email/Alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=alerts@yourdomain.com

# AWS/Cloud (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=maaps-audio-storage

# Performance
MAX_UPLOAD_SIZE_MB=100
REQUEST_TIMEOUT_SECONDS=60
WORKER_CONNECTIONS=1000

# Feature Flags
ENABLE_AUDIO_ENHANCEMENT=true
ENABLE_MUSIC_GENERATION=true
ENABLE_BATCH_PROCESSING=true
ENABLE_REAL_TIME_PROCESSING=true

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# Model Configuration
MODEL_CACHE_DIR=/app/data/models
DEMUCS_MODEL=htdemucs
ENABLE_GPU=true
