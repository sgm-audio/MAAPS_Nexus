# Multi-Agent Audio Processing System - Environment Configuration

# System Configuration
AGENT_LOG_LEVEL=INFO
AGENT_HEARTBEAT_INTERVAL=1.0

# Message Bus
MESSAGE_BUS_MAX_QUEUE_SIZE=10000
MESSAGE_BUS_DISPATCHER_THREADS=4

# Resource Limits
MAX_CPU_USAGE_PERCENT=85.0
MAX_MEMORY_USAGE_PERCENT=90.0
MAX_GPU_USAGE_PERCENT=90.0

# Cache Configuration
CACHE_MAX_SIZE_MB=500
CACHE_EVICTION_POLICY=lru

# Database
METADATA_DB_PATH=./data/metadata.db
PROJECT_DB_PATH=./data/projects.db

# Performance
ENABLE_GPU=false
GPU_DEVICE_ID=0
MAX_WORKER_THREADS=8

# Monitoring
ENABLE_HEALTH_MONITORING=true
HEALTH_CHECK_INTERVAL=5.0
METRICS_COLLECTION_INTERVAL=1.0

# Logging
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/system.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=5

# Audio Processing Defaults
DEFAULT_SAMPLE_RATE=44100
DEFAULT_BUFFER_SIZE=512
AUDIO_CHUNK_SIZE=1024

# Workflow Configuration
WORKFLOW_MAX_RETRIES=3
WORKFLOW_RETRY_DELAY_SECONDS=1.0
WORKFLOW_DEFAULT_TIMEOUT_SECONDS=300

# Safety Limits
MAX_AUDIO_LENGTH_SECONDS=600
MAX_PROCESSING_TIME_SECONDS=300
MAX_CONCURRENT_WORKFLOWS=10
