# Multi-Agent Audio Processing System - systemd service file
# Installation: sudo cp maaps.service /etc/systemd/system/
# Enable: sudo systemctl enable maaps
# Start: sudo systemctl start maaps

[Unit]
Description=Multi-Agent Audio Processing System (MAAPS)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=maaps
Group=maaps
WorkingDirectory=/opt/maaps

# Environment
Environment="PATH=/opt/maaps/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/opt/maaps/.env.production

# Execution
ExecStart=/opt/maaps/venv/bin/python /opt/maaps/my_audio_app.py
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy
Restart=on-failure
RestartSec=10s
StartLimitInterval=5min
StartLimitBurst=3

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryLimit=8G
CPUQuota=400%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/maaps/data /opt/maaps/logs /opt/maaps/backups

# Logging
StandardOutput=append:/var/log/maaps/stdout.log
StandardError=append:/var/log/maaps/stderr.log
SyslogIdentifier=maaps

# Graceful shutdown
TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
